/**
 * Helper function to detect main menu / course list pages.
 * Used to determine when NOT to show the sidebar.
 */
export function isExampleSchoolMainMenu(url: URL): boolean {
  if (!exampleSchoolAdapter.matches(url)) return false;

  const path = url.pathname;

  // Classic portal patterns
  if (path.includes('/webapps/portal/')) return true;

  // Ultra patterns
  if (path === '/ultra' || path === '/ultra/') return true;
  if (path.startsWith('/ultra/institution-page')) return true;
  if (path.startsWith('/ultra/stream')) return true;
  if (path === '/ultra/course' || path.startsWith('/ultra/course?')) return true;

  return false;
}

